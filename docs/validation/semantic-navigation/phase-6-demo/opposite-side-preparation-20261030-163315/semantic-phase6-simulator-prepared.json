    "volumes": [
      {
        "configMap": {
          "defaultMode": 420,
          "name": "semantic-phase6-demo-bridge-config"
        },
        "name": "bridge-config"
      },
      {
        "configMap": {
          "defaultMode": 420,
          "items": [
            {
              "key": "install_phase1_camera.py",
              "path": "install_phase1_camera.py"
            },
            {
              "key": "support_geometry.py",
              "path": "support_geometry.py"
            },
            {
              "key": "demo_ground_truth.py",
              "path": "demo_ground_truth.py"
            }
