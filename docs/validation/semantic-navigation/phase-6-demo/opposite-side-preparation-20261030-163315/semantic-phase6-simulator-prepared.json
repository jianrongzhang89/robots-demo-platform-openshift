        "level": "s0:c37,c4"
      },
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "serviceAccount": "default",
    "serviceAccountName": "default",
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "cpu-taint",
        "operator": "Equal",
        "value": "true"
      },
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/not-ready",
        "operator": "Exists",
