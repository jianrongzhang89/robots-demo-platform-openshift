{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "labels": {
      "app": "semantic-phase8-sam3-adapter",
      "app.kubernetes.io/part-of": "semantic-navigation-demo",
      "semantic-navigation.robots-demo/phase": "phase8-topology",
      "semantic-serving-client": "sam3-mat-v1"
    },
    "name": "semantic-phase8-sam3-adapter",
    "namespace": "semantic-navigation"
  },
  "spec": {
    "containers": [
      {
        "args": [
          "-c",
          "/phase6-bridges/sam3-bridge.json5"
        ],
        "env": [
          {
            "name": "ROS_DOMAIN_ID",
            "value": "82"
          },
          {
            "name": "ROS_DISTRO",
            "value": "jazzy"
          },
          {
            "name": "RMW_IMPLEMENTATION",
            "value": "rmw_cyclonedds_cpp"
          },
          {
            "name": "CYCLONEDDS_URI",
            "value": "file:///phase6-bridges/cyclonedds.xml"
          }
        ],
        "image": "eclipse/zenoh-bridge-ros2dds@sha256:38f162ae5236412f4f02e77927e22585356f7e706db39ec1c6194b9bd0d05b18",
        "imagePullPolicy": "IfNotPresent",
        "name": "sam3-zenoh-bridge",
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          },
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "runAsNonRoot": true,
          "runAsUser": 1000
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/phase6-bridges",
            "name": "bridge-config",
            "readOnly": true
          },
          {
            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
            "name": "kube-api-access-6fqgk",
            "readOnly": true
          }
        ]
      },
      {
        "args": [
          "source /opt/ros/jazzy/setup.bash; exec python3 /phase8/phase8_sam3_http_policy.py --ros-args -p backend:=http -p robot_id:=robot_1 -p stream_id:=camera/color -p input_prefix:=/robot_1/camera -p output_prefix:=/robot_1/semantic"
        ],
        "command": [
          "/bin/bash",
          "-lc"
        ],
        "env": [
          {
            "name": "ROS_DOMAIN_ID",
            "value": "82"
          },
          {
            "name": "ROS_DISTRO",
            "value": "jazzy"
          },
          {
            "name": "HOME",
            "value": "/tmp/phase8-sam3-home"
          },
          {
            "name": "ROS_LOG_DIR",
            "value": "/tmp/phase8-sam3-logs"
          },
          {
            "name": "RMW_IMPLEMENTATION",
            "value": "rmw_cyclonedds_cpp"
          },
          {
            "name": "CYCLONEDDS_URI",
            "value": "file:///phase6-bridges/cyclonedds.xml"
          },
          {
            "name": "SAM3_PROMPT",
            "value": "red mat"
          },
          {
            "name": "SEMANTIC_REQUIRE_CAPTURE_TRACE",
            "value": "1"
          },
          {
            "name": "SEMANTIC_MAX_WORK_WAIT_MS",
            "value": "40"
          },
          {
            "name": "SEMANTIC_CLOCK_UNCERTAINTY_MS",
            "value": "2"
          },
          {
            "name": "SEMANTIC_BACKEND",
            "value": "http"
          },
          {
            "name": "SEMANTIC_ENDPOINT",
            "value": "https://sam3-mat-v1-tls.semantic-model-serving.svc:8443"
          },
          {
            "name": "SEMANTIC_TLS_CA",
            "value": "/phase8-serving-tls/ca.crt"
          },
          {
            "name": "SEMANTIC_TLS_CERT",
            "value": "/phase8-serving-tls/tls.crt"
          },
          {
            "name": "SEMANTIC_TLS_KEY",
            "value": "/phase8-serving-tls/tls.key"
          },
          {
            "name": "SEMANTIC_DEPLOYMENT_IDENTITY",
            "value": "/phase8/identity.json"
          },
          {
            "name": "SEMANTIC_STATUS_FILE",
            "value": "/tmp/semantic-status.json"
          }
        ],
        "image": "image-registry.openshift-image-registry.svc:5000/semantic-navigation/semantic-cpu-adapter@sha256:20ea4f5e6bc30646f48b29895eb071d40403f8c20b0c1526aeacf06dce716d4b",
        "imagePullPolicy": "IfNotPresent",
        "name": "sam3-inference",
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "2",
            "memory": "2Gi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/phase6-bridges",
            "name": "bridge-config",
            "readOnly": true
          },
          {
            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
            "name": "kube-api-access-6fqgk",
            "readOnly": true
          },
          {
            "name": "phase8-config",
            "mountPath": "/phase8",
            "readOnly": true
          },
          {
            "name": "phase8-serving-tls",
            "mountPath": "/phase8-serving-tls",
            "readOnly": true
          },
          {
            "name": "phase8-serving-tmp",
            "mountPath": "/tmp"
          }
        ],
        "readinessProbe": {
          "exec": {
            "command": [
              "python3",
              "-c",
              "import json,time; s=json.load(open('/tmp/semantic-status.json')); assert s['ready'] and s['backend']=='http' and s['deployment_identity']==json.load(open('/phase8/identity.json')) and 0 <= time.time_ns()-s['status_wall_ns'] < 500000000"
            ]
          },
          "periodSeconds": 1,
          "timeoutSeconds": 1,
          "failureThreshold": 1
        }
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "enableServiceLinks": true,
    "imagePullSecrets": [
      {
        "name": "default-dockercfg-6jjg8"
      }
    ],
    "nodeName": "ip-10-0-18-251.ec2.internal",
    "nodeSelector": {
      "kubernetes.io/hostname": "ip-10-0-18-251.ec2.internal"
    },
    "preemptionPolicy": "PreemptLowerPriority",
    "priority": 0,
    "restartPolicy": "Always",
    "schedulerName": "default-scheduler",
    "securityContext": {
      "fsGroup": 1001340000,
      "fsGroupChangePolicy": "OnRootMismatch",
      "seLinuxOptions": {
        "level": "s0:c37,c4"
      },
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "serviceAccount": "default",
    "serviceAccountName": "default",
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "g6e-gpu",
        "operator": "Equal",
        "value": "true"
      },
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/not-ready",
        "operator": "Exists",
        "tolerationSeconds": 300
      },
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/unreachable",
        "operator": "Exists",
        "tolerationSeconds": 300
      },
      {
        "effect": "NoSchedule",
        "key": "node.kubernetes.io/memory-pressure",
        "operator": "Exists"
      }
    ],
    "volumes": [
      {
        "configMap": {
          "defaultMode": 420,
          "name": "semantic-phase6-demo-bridge-config"
        },
        "name": "bridge-config"
      },
      {
        "name": "kube-api-access-6fqgk",
        "projected": {
          "defaultMode": 420,
          "sources": [
            {
              "serviceAccountToken": {
                "expirationSeconds": 3607,
                "path": "token"
              }
            },
            {
              "configMap": {
                "items": [
                  {
                    "key": "ca.crt",
                    "path": "ca.crt"
                  }
                ],
                "name": "kube-root-ca.crt"
              }
            },
            {
              "downwardAPI": {
                "items": [
                  {
                    "fieldRef": {
                      "apiVersion": "v1",
                      "fieldPath": "metadata.namespace"
                    },
                    "path": "namespace"
                  }
                ]
              }
            },
            {
              "configMap": {
                "items": [
                  {
                    "key": "service-ca.crt",
                    "path": "service-ca.crt"
                  }
                ],
                "name": "openshift-service-ca.crt"
              }
            }
          ]
        }
      },
      {
        "name": "phase8-config",
        "configMap": {
          "name": "semantic-phase8-rmf-config"
        }
      },
      {
        "name": "phase8-serving-tls",
        "secret": {
          "secretName": "sam3-replay-tls",
          "defaultMode": 288
        }
      },
      {
        "name": "phase8-serving-tmp",
        "emptyDir": {
          "sizeLimit": "256Mi"
        }
      }
    ]
  }
}