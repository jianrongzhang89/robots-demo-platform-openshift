{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "semantic-model-serving",
        "labels": {
          "opendatahub.io/dashboard": "true",
          "modelmesh-enabled": "false"
        },
        "annotations": {
          "openshift.io/display-name": "Semantic model serving"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "sam3-serving",
        "namespace": "semantic-model-serving"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "sam3-client-policy",
        "namespace": "semantic-model-serving"
      },
      "data": {
        "clients.json": "{\"spiffe://semantic-navigation/sa/sam3-replay\": [[\"robot_1\", \"camera/color\"]]}"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "sam3-mat-v1-tls",
        "namespace": "semantic-model-serving"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "serving.kserve.io/inferenceservice": "sam3-mat-v1",
          "component": "predictor"
        },
        "ports": [
          {
            "name": "https",
            "port": 8443,
            "targetPort": 8443
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "sam3-isolation",
        "namespace": "semantic-model-serving"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "serving.kserve.io/inferenceservice": "sam3-mat-v1",
            "component": "predictor"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "egress": [],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "semantic-navigation"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "semantic-serving-client": "sam3-mat-v1"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8443
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "sam3-checkpoint",
        "namespace": "semantic-model-serving",
        "annotations": {
          "semantic-navigation.robots-demo/model-sha256": "9999e2341ceef5e136daa386eecb55cb414446a00ac2b55eb2dfd2f7c3cf8c9e",
          "semantic-navigation.robots-demo/model-revision": "3c879f39826c281e95690f02c7821c4de09afae7"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "gp3-csi",
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "sam3-serving-budget",
        "namespace": "semantic-model-serving"
      },
      "spec": {
        "hard": {
          "requests.cpu": "8",
          "requests.memory": "28Gi",
          "limits.cpu": "16",
          "limits.memory": "56Gi",
          "requests.nvidia.com/gpu": "1",
          "requests.storage": "10Gi",
          "persistentvolumeclaims": "1",
          "pods": "8"
        }
      }
    }
  ]
}
