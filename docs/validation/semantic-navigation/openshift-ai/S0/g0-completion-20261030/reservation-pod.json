{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "sam3-g0-reservation",
    "namespace": "semantic-model-serving"
  },
  "spec": {
    "serviceAccountName": "sam3-serving",
    "automountServiceAccountToken": false,
    "restartPolicy": "Never",
    "nodeSelector": {
      "nvidia.com/gpu.product": "NVIDIA-L40S",
      "kubernetes.io/hostname": "ip-10-0-55-175.ec2.internal"
    },
    "tolerations": [
      {
        "key": "g6e-gpu",
        "operator": "Equal",
        "value": "true",
        "effect": "NoSchedule"
      }
    ],
    "containers": [
      {
        "name": "reservation",
        "image": "image-registry.openshift-image-registry.svc:5000/semantic-navigation/semantic-model-server@sha256:f9bcc273a164f741426079ccf4c9d2269c9ec5e9530845029e593bf466a3aa2e",
        "command": [
          "/opt/sam3-venv/bin/python",
          "-u",
          "-c"
        ],
        "args": [
          "import torch,json,time; print(json.dumps({\"gpu\":torch.cuda.get_device_name(),\"cuda\":torch.version.cuda,\"torch\":torch.__version__,\"bf16\":torch.cuda.is_bf16_supported()}),flush=True); time.sleep(604800)"
        ],
        "resources": {
          "requests": {
            "cpu": "3",
            "memory": "12Gi",
            "nvidia.com/gpu": "1"
          },
          "limits": {
            "cpu": "6",
            "memory": "24Gi",
            "nvidia.com/gpu": "1"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "runAsNonRoot": true,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "volumeMounts": [
          {
            "name": "model",
            "mountPath": "/models",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "model",
        "persistentVolumeClaim": {
          "claimName": "sam3-checkpoint"
        }
      }
    ],
    "securityContext": {
      "fsGroup": 1000840000,
      "fsGroupChangePolicy": "OnRootMismatch"
    },
    "terminationGracePeriodSeconds": 5
  }
}
