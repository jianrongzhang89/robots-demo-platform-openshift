                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "accelerator_gpu_utilization{exported_namespace=\"semantic-model-serving\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "memory": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Serving GPU memory used"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "bytes"
                      },
