                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "time() - g5_navigation_last_capture_timestamp_seconds{namespace=\"semantic-navigation\",service=\"semantic-g5-navigation-metrics\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "navigation_result": {
              "kind": "Panel",
