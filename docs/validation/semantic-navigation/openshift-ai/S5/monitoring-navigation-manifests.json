          "layouts": [
            {
              "kind": "Grid",
              "spec": {
                "display": {
                  "title": "Authenticated serving telemetry"
                },
                "items": [
                  {
                    "content": {
                      "$ref": "#/spec/panels/scrape"
                    },
                    "x": 0,
                    "y": 0,
                    "width": 12,
                    "height": 8
                  },
                  {
                    "content": {
                      "$ref": "#/spec/panels/rate"
                    },
                    "x": 12,
                    "y": 0,
                    "width": 12,
                    "height": 8
                  },
                  {
                    "content": {
                      "$ref": "#/spec/panels/count"
                    },
                    "x": 0,
                    "y": 8,
                    "width": 12,
                    "height": 8
                  },
                  {
                    "content": {
                      "$ref": "#/spec/panels/ready"
                    },
                    "x": 12,
                    "y": 8,
                    "width": 12,
                    "height": 8
                  },
                  {
                    "content": {
                      "$ref": "#/spec/panels/busy"
