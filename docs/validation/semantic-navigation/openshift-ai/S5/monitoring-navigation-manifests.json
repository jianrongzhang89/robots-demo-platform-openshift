{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "sam3-g5-authenticated",
        "namespace": "semantic-model-serving"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "semantic-g5-monitor": "sam3"
          }
        },
        "endpoints": [
          {
            "port": "https",
            "path": "/metrics",
            "scheme": "https",
            "interval": "15s",
            "scrapeTimeout": "5s",
            "tlsConfig": {
              "serverName": "sam3-mat-v1-tls.semantic-model-serving.svc",
              "ca": {
                "secret": {
                  "name": "sam3-g5-monitor-tls",
                  "key": "ca.crt"
                }
              },
              "cert": {
                "secret": {
                  "name": "sam3-g5-monitor-tls",
                  "key": "tls.crt"
                }
              },
              "keySecret": {
                "name": "sam3-g5-monitor-tls",
                "key": "tls.key"
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "sam3-g5-monitor-ingress",
        "namespace": "semantic-model-serving"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "serving.kserve.io/inferenceservice": "sam3-mat-v1",
            "component": "predictor"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "openshift-user-workload-monitoring"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "prometheus": "user-workload"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8443
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "perses.dev/v1alpha2",
      "kind": "PersesDashboard",
      "metadata": {
        "name": "semantic-g5-serving",
        "namespace": "redhat-ods-monitoring",
        "labels": {
          "app.opendatahub.io/dashboard": "true"
        }
      },
      "spec": {
        "config": {
          "display": {
            "name": "SAM3 G5 serving and navigation",
            "description": "G5 HOLD. Missing series mean unavailable, never healthy zero. Candidate histograms are absent on the accepted rollback image. Navigation data is passive operator telemetry; missing or stale sources are unavailable. Costmap latency is absent when the fixture does not expose applied updates. Evidence: https://github.com/jianrongzhang89/robots-demo-platform-openshift/tree/be091bd2/docs/validation/semantic-navigation/openshift-ai/S4"
          },
          "duration": "1h",
          "panels": {
            "scrape": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Authenticated scrape health"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "decimal"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "up{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "rate": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Inference requests / second by status"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "decimal"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "sum by (status) (rate(semantic_requests_total{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"}[5m]))"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "count": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Inference outcomes since worker start"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "decimal"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "sum by (status) (semantic_requests_total{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"})"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "ready": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Worker ready"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "decimal"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "semantic_worker_ready{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "busy": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Worker busy"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "decimal"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "semantic_worker_busy{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "backend": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Candidate backend p95 (not capture latency)"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "seconds"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "histogram_quantile(0.95, sum by (le) (rate(semantic_backend_duration_seconds_bucket{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"}[5m])))"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "admission": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Candidate admission p95"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "seconds"
                      },
                      "min": 0
                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "histogram_quantile(0.95, sum by (le) (rate(semantic_admission_duration_seconds_bucket{namespace=\"semantic-model-serving\",service=\"sam3-mat-v1-tls\"}[5m])))"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "queue": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Candidate queue capacity (zero = immediate rejection)"
