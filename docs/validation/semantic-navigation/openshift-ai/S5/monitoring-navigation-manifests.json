            },
            "navigation_capture": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Wall age of last valid capture"
                },
                "plugin": {
                  "kind": "TimeSeriesChart",
                  "spec": {
                    "visual": {
                      "display": "line",
                      "connectNulls": false
                    },
                    "yAxis": {
                      "format": {
                        "unit": "seconds"
                      },
