                    }
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "accelerator_memory_used_bytes{exported_namespace=\"semantic-model-serving\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "identity": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Running image identity (pod inventory)"
                },
                "plugin": {
                  "kind": "Table",
                  "spec": {
                    "columnSettings": [
                      {
                        "name": "timestamp",
                        "hide": true
                      },
                      {
                        "name": "image_id",
                        "header": "Image digest"
                      }
                    ]
                  }
                },
                "queries": [
                  {
                    "kind": "TimeSeriesQuery",
                    "spec": {
                      "plugin": {
                        "kind": "PrometheusTimeSeriesQuery",
                        "spec": {
                          "datasource": {
                            "kind": "PrometheusDatasource",
                            "name": "cluster-prometheus-tenancy-datasource"
                          },
                          "query": "kube_pod_container_info{namespace=\"semantic-model-serving\",container=\"kserve-container\"}"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "navigation_source": {
              "kind": "Panel",
              "spec": {
                "display": {
                  "name": "Navigation snapshot available"
                },
                "plugin": {
