{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "semantic-s3-inference",
    "namespace": "semantic-navigation",
    "labels": {
      "app": "semantic-s3-inference",
      "semantic-serving-client": "sam3-mat-v1"
    }
  },
  "spec": {
    "restartPolicy": "Always",
    "nodeSelector": {
      "kubernetes.io/hostname": "ip-10-0-53-174.ec2.internal"
    },
    "containers": [
      {
        "name": "inference-zenoh-bridge",
        "image": "eclipse/zenoh-bridge-ros2dds@sha256:38f162ae5236412f4f02e77927e22585356f7e706db39ec1c6194b9bd0d05b18",
        "args": [
          "-c",
          "/g3-config/inference-bridge.json5"
        ],
        "env": [
          {
            "name": "ROS_DOMAIN_ID",
            "value": "191"
          },
          {
            "name": "ROS_DISTRO",
            "value": "jazzy"
          },
          {
            "name": "HOME",
            "value": "/tmp/sam3-home"
          },
          {
            "name": "ROS_LOG_DIR",
            "value": "/tmp/ros-log"
          },
          {
            "name": "RMW_IMPLEMENTATION",
            "value": "rmw_cyclonedds_cpp"
          },
          {
            "name": "CYCLONEDDS_URI",
            "value": "file:///g3-config/cyclonedds.xml"
          }
        ],
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/g3-config",
            "readOnly": true
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        }
      },
      {
        "name": "adapter",
        "image": "image-registry.openshift-image-registry.svc:5000/semantic-navigation/semantic-cpu-adapter@sha256:20ea4f5e6bc30646f48b29895eb071d40403f8c20b0c1526aeacf06dce716d4b",
        "command": [
          "/bin/bash",
          "-ec"
        ],
        "args": [
          "source /opt/ros/jazzy/setup.bash; exec python3 /opt/semantic-perception/sam3_ros_node.py --ros-args -p backend:=http -p robot_id:=robot_1 -p stream_id:=camera/color"
        ],
        "env": [
          {
            "name": "SEMANTIC_BACKEND",
            "value": "http"
          },
          {
            "name": "SEMANTIC_ENDPOINT",
            "value": "https://sam3-mat-v1-tls.semantic-model-serving.svc:8443"
          },
          {
            "name": "SEMANTIC_TLS_CA",
            "value": "/cert/ca.crt"
          },
          {
            "name": "SEMANTIC_TLS_CERT",
            "value": "/cert/tls.crt"
          },
          {
            "name": "SEMANTIC_TLS_KEY",
            "value": "/cert/tls.key"
          },
          {
            "name": "SEMANTIC_DEPLOYMENT_IDENTITY",
            "value": "/g3-config/identity.json"
          },
          {
            "name": "SEMANTIC_REQUIRE_CAPTURE_TRACE",
            "value": "1"
          },
          {
            "name": "SEMANTIC_CLOCK_UNCERTAINTY_MS",
            "value": "2"
          },
          {
            "name": "SEMANTIC_MAX_WORK_WAIT_MS",
            "value": "60"
          },
          {
            "name": "SEMANTIC_STATUS_FILE",
            "value": "/tmp/semantic-status.json"
          },
          {
            "name": "ROS_DOMAIN_ID",
            "value": "191"
          },
          {
            "name": "CYCLONEDDS_URI",
            "value": "file:///g3-config/cyclonedds-consumer.xml"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "2",
            "memory": "2Gi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "readinessProbe": {
          "exec": {
            "command": [
              "python3",
              "-c",
              "import json,time; s=json.load(open(\"/tmp/semantic-status.json\")); assert s[\"ready\"] and 0 <= time.time_ns()-s[\"status_wall_ns\"] < 500000000"
            ]
          },
          "periodSeconds": 1,
          "timeoutSeconds": 1,
          "failureThreshold": 1
        },
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/g3-config",
            "readOnly": true
          },
          {
            "name": "tls",
            "mountPath": "/cert",
            "readOnly": true
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ]
      },
      {
        "name": "costmap-observer",
        "image": "image-registry.openshift-image-registry.svc:5000/semantic-navigation/semantic-g3-costmap@sha256:456f2707026b9de64275669f6a5d14bda1ef927c15ab35aa848801b1e94b2ec9",
        "command": [
          "/bin/bash",
          "-lc"
        ],
        "args": [
          "source /opt/semantic-costmap-ws/install/setup.bash; exec /opt/g3/build/g3_observer --ros-args -p use_sim_time:=true -p global_frame:=odom -r /tf:=/robot_1/tf -r /tf_static:=/robot_1/tf_static"
        ],
        "env": [
          {
            "name": "ROS_DOMAIN_ID",
            "value": "191"
          },
          {
            "name": "ROS_LOG_DIR",
            "value": "/tmp/phase4-ros-logs"
          },
          {
            "name": "RMW_IMPLEMENTATION",
            "value": "rmw_cyclonedds_cpp"
          },
          {
            "name": "CYCLONEDDS_URI",
            "value": "file:///g3-config/cyclonedds-consumer.xml"
          }
        ],
        "volumeMounts": [
          {
            "name": "config",
            "mountPath": "/g3-config",
            "readOnly": true
          }
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "3",
            "memory": "3Gi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      },
      {
        "name": "background-load",
        "image": "image-registry.openshift-image-registry.svc:5000/semantic-navigation/semantic-cpu-adapter@sha256:20ea4f5e6bc30646f48b29895eb071d40403f8c20b0c1526aeacf06dce716d4b",
        "command": [
          "python3",
          "-c"
        ],
        "args": [
          "import time\nwhile True:\n t=time.monotonic()\n while time.monotonic()-t<0.05: pass\n time.sleep(0.05)"
        ],
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ],
    "volumes": [
      {
        "name": "config",
        "configMap": {
          "name": "semantic-s3-inference-config"
        }
      },
      {
        "name": "tls",
        "secret": {
          "secretName": "sam3-replay-tls",
          "defaultMode": 288
        }
      },
      {
        "name": "tmp",
        "emptyDir": {
          "sizeLimit": "512Mi"
        }
      }
    ],
    "automountServiceAccountToken": false,
    "serviceAccountName": "sam3-replay"
  }
}
