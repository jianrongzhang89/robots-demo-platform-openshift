# Minimal Lyrical image for odometry testing
# Tests if DART 6.16.6 fixes the continuous joint bug
# Without Nav2 (packages not yet available)

FROM quay.io/jianrzha/ros2-rmf-hotel:lyrical-base

ENV ROS_DISTRO=lyrical \
    DEBIAN_FRONTEND=noninteractive

# Install RMF demos and CycloneDDS (try apt first, source build if unavailable)
RUN apt-get update && \
    apt-get install -y \
        ros-lyrical-rmw-cyclonedds-cpp \
        ros-lyrical-cyclonedds && \
    (apt-get install -y \
        ros-lyrical-rmf-demos \
        ros-lyrical-rmf-demos-gz \
        ros-lyrical-rmf-demos-maps \
    || echo "RMF packages not available, will use source") \
    && rm -rf /var/lib/apt/lists/*

# Build RMF from source if needed
SHELL ["/bin/bash", "-c"]
RUN if [ ! -d "/opt/ros/lyrical/share/rmf_demos" ]; then \
        mkdir -p /opt/rmf_demos_ws/src && \
        cd /opt/rmf_demos_ws/src && \
        git clone https://github.com/open-rmf/rmf_demos.git -b main && \
        cd /opt/rmf_demos_ws && \
        source /opt/ros/lyrical/setup.bash && \
        apt-get update && \
        (rosdep install --from-paths src --ignore-src -r -y || echo "Some rosdeps failed, continuing...") && \
        colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release --continue-on-error && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Install VNC tools
RUN apt-get update && apt-get install -y \
    tigervnc-standalone-server \
    xvfb \
    openbox \
    x11vnc \
    websockify \
    novnc \
    && rm -rf /var/lib/apt/lists/*

# Copy entrypoints and scripts
COPY entrypoints/entrypoint-hotel.sh /entrypoint-hotel.sh
COPY entrypoints/rmf_puppet_controller.py /entrypoints/rmf_puppet_controller.py
COPY scripts/spawn_turtlebot3_hotel.py /opt/ros2-demo/scripts/
COPY scripts/patch_hotel_world.py /tmp/
COPY scripts/patch_hotel_world_add_robot.py /tmp/
RUN chmod +x /entrypoint-hotel.sh /opt/ros2-demo/scripts/spawn_turtlebot3_hotel.py && \
    mkdir -p /entrypoints

# Apply patches (find hotel.world in build or install directory)
# Note: Patches are optional - we can test DART 6.16.6 odometry without them
RUN HOTEL_WORLD=$(find /opt/rmf_demos_ws -name "hotel.world" -type f | head -1) && \
    if [ -n "$HOTEL_WORLD" ]; then \
        echo "Found hotel.world at: $HOTEL_WORLD" && \
        (python3 /tmp/patch_hotel_world.py "$HOTEL_WORLD" "$HOTEL_WORLD" || echo "Patch 1 failed, continuing...") && \
        (python3 /tmp/patch_hotel_world_add_robot.py || echo "Patch 2 failed, continuing..."); \
    else \
        echo "hotel.world not found, skipping patches"; \
    fi && \
    rm /tmp/*.py

RUN mkdir -p /opt/ros2-demo/www

# Verify DART 6.16.6 one final time
RUN echo "=== DART Version Check ===" && \
    dpkg -l | grep dartsim && \
    echo "=== Expected: DART 6.16.6 ==="

LABEL org.opencontainers.image.title="ROS2 Lyrical Minimal - Odometry Test" \
      org.opencontainers.image.description="Hotel world with DART 6.16.6 (no Nav2) for odometry testing"

CMD ["/entrypoint-hotel.sh"]
