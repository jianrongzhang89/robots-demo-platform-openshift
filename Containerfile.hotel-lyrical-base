# ROS2 Lyrical Luth + Gazebo Jetty Base Image
# Ubuntu 26.04 + ROS2 Lyrical + DART 6.16.6
#
# This base image fixes the continuous joint DOF=0 bug present in
# Jazzy's DART 6.13.2 by upgrading to DART 6.16.6 in Gazebo Jetty.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=lyrical \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Install locales and basic tools
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    software-properties-common \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Add ROS2 apt repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS2 Lyrical (includes Gazebo Jetty automatically)
# Note: Package naming changed in Lyrical - ros-gz instead of gazebo-ros-pkgs
RUN apt-get update && apt-get install -y \
    ros-lyrical-desktop \
    ros-lyrical-ros-gz \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Gazebo Jetty and DART 6.16.6 are included in ros-lyrical-desktop
# Verify they are present
RUN dpkg -l | grep -E "gz-sim|dartsim" || echo "Checking Gazebo/DART installation..."

# Verify DART version (should be 6.16.6 or higher)
RUN echo "=== Verifying DART Physics Version ===" && \
    dpkg -l | grep dartsim && \
    echo "=== DART verification complete ==="

# Initialize rosdep
RUN rosdep init || true && \
    rosdep update

# Source ROS2 environment by default
RUN echo "source /opt/ros/lyrical/setup.bash" >> /root/.bashrc

LABEL org.opencontainers.image.title="ROS2 Lyrical Base with Gazebo Jetty" \
      org.opencontainers.image.description="Ubuntu 26.04 + ROS2 Lyrical + Gazebo Jetty (DART 6.16.6)" \
      org.opencontainers.image.source="https://github.com/jianrongzhang89/robots-demo-platform-openshift"

CMD ["/bin/bash"]
