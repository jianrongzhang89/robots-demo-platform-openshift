{
  plugins: {
    ros2dds: {
      // No namespace prefix — Gazebo topics are already namespaced by ROS2
      // (/robot_1/*, /robot_2/*) via spawn_tb3 namespace argument.
      //
      // Exclude the absolute /tf and /tf_static topics.  spawn_tb3 may create
      // additional RSP nodes that publish to the absolute /tf, causing conflicting
      // DDS QoS profiles that trigger "Bad Parameter" errors in the bridge.
      // All needed TF data is available through the namespaced /robot_N/tf[_static].
      deny: {
        publishers:  ["^/tf$", "^/tf_static$"],
        subscribers: ["^/tf$", "^/tf_static$"],
      },
    }
  },

  // Client mode: connect to the dedicated zenoh-router pod.
  // If the router restarts, the bridge retries automatically.
  mode: "client",

  connect: {
    endpoints: [
      "tcp/zenoh-router:7447"
    ],
    retry: {
      period_init_ms: 1000,
      period_max_ms: 16000,
      period_increase_factor: 2
    },
    exit_on_failure: false
  },

  scouting: {
    multicast: {
      enabled: false
    }
  }
}
