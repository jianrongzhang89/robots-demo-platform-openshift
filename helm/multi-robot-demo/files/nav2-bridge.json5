{
  plugins: {
    ros2dds: {
      // No namespace prefix — Nav2 already runs under /robot_N/ namespace,
      // so all its local DDS topics are already correctly prefixed.
      //
      // Exclude the absolute /tf and /tf_static topics.  With use_namespace:=True,
      // Nav2 uses /robot_N/tf[_static] exclusively.  The absolute /tf has many
      // incompatible DDS publishers (from multiple processes across pods), which
      // causes "Bad Parameter" DDS reader creation errors in the bridge and breaks
      // bridging for the namespaced /robot_N/tf topics as well.
      deny: {
        publishers:  ["^/tf$", "^/tf_static$"],
        subscribers: ["^/tf$", "^/tf_static$"],
      },
    }
  },

  // Client mode: connect to the dedicated zenoh-router pod.
  // Nav2 pods survive Gazebo restarts because the router is independent.
  mode: "client",

  connect: {
    endpoints: [
      "tcp/zenoh-router:7447"
    ],
    retry: {
      period_init_ms: 1000,
      period_max_ms: 16000,
      period_increase_factor: 2
    },
    exit_on_failure: false
  },

  scouting: {
    multicast: {
      enabled: false
    }
  }
}
