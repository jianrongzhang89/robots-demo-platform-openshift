# Reproducible first milestone: Gazebo Harmonic + Nav2 + OpenRMF in one pod.
# This is the amd64 manifest for ros:jazzy observed on 2026-09-16.
FROM --platform=linux/amd64 ros:jazzy@sha256:efbc8cb259b6346f1c8944ffd49d3fbffd647116ec05006df8b36444a13b7bdf

ARG RMF_DEMOS_COMMIT=3f7b9727ce39ba421ba5727eed9d8612f1c85f66
ARG RMF_SIMULATION_COMMIT=ec6add4a842a5051a070fafb146208e7f2aa9742
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=jazzy

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg lsb-release git ca-certificates \
      python3-colcon-common-extensions python3-rosdep python3-vcstool \
      python3-yaml python3-pil \
      ros-jazzy-navigation2 ros-jazzy-nav2-bringup \
      ros-jazzy-rmf-dev ros-jazzy-rmf-building-sim-gz-plugins \
      ros-jazzy-rmf-robot-sim-gz-plugins ros-jazzy-rmf-building-map-tools \
      ros-jazzy-ros-gz ros-jazzy-rmw-cyclonedds-cpp \
      ros-jazzy-robot-state-publisher ros-jazzy-tf-transformations \
      xvfb xserver-xorg-video-dummy x11vnc novnc python3-websockify openbox \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
      -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable noble main" \
      > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends gz-harmonic \
    && rm -rf /var/lib/apt/lists/*

COPY patches/rmf_simulation_lift_session.patch /tmp/rmf_simulation_lift_session.patch
COPY patches/rmf_simulation_lift_payload_velocity.patch /tmp/rmf_simulation_lift_payload_velocity.patch
COPY patches/gz_gui_camera_tracking_recovery.patch /tmp/gz_gui_camera_tracking_recovery.patch
RUN git clone https://github.com/open-rmf/rmf_simulation.git /tmp/rmf_simulation \
    && git -C /tmp/rmf_simulation checkout "${RMF_SIMULATION_COMMIT}" \
    && git -C /tmp/rmf_simulation apply /tmp/rmf_simulation_lift_session.patch \
    && python3 -c 'from pathlib import Path; p=Path("/tmp/rmf_simulation/rmf_building_sim_gz_plugins/src/lift.cpp"); s=p.read_text(); old="if (target_velocity != 0.0)"; assert old in s; p.write_text(s.replace(old, "if (true)"))' \
    && . /opt/ros/jazzy/setup.sh \
    && colcon build --base-paths /tmp/rmf_simulation \
         --build-base /tmp/rmf-sim-build --install-base /tmp/rmf-sim-install \
         --packages-select rmf_building_sim_gz_plugins \
         --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && find /tmp/rmf-sim-install /tmp/rmf-sim-build -name liblift.so -type f -exec cp {} \
         /opt/ros/jazzy/lib/rmf_building_sim_gz_plugins/liblift.so \; -quit \
    && test -f /opt/ros/jazzy/lib/rmf_building_sim_gz_plugins/liblift.so \
    && rm -rf /tmp/rmf_simulation /tmp/rmf-sim-build /tmp/rmf-sim-install \
          /tmp/rmf-sim-log /tmp/rmf_simulation_lift_session.patch \
          /tmp/rmf_simulation_lift_payload_velocity.patch

RUN git clone --depth 1 --branch gz-gui8 https://github.com/gazebosim/gz-gui.git /tmp/gz-gui \
    && git -C /tmp/gz-gui apply /tmp/gz_gui_camera_tracking_recovery.patch \
    && cmake -S /tmp/gz-gui -B /tmp/gz-gui-build \
         -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
         -DCMAKE_INSTALL_PREFIX=/tmp/gz-gui-install \
    && cmake --build /tmp/gz-gui-build --target CameraTracking --parallel 2 \
    && find /tmp/gz-gui-build -name libCameraTracking.so -type f -exec cp {} \
         /opt/ros/jazzy/opt/gz_gui_vendor/lib/gz-gui-8/plugins/libCameraTracking.so \; -quit \
    && test -f /opt/ros/jazzy/opt/gz_gui_vendor/lib/gz-gui-8/plugins/libCameraTracking.so \
    && rm -rf /tmp/gz-gui /tmp/gz-gui-build /tmp/gz-gui-install \
         /tmp/gz_gui_camera_tracking_recovery.patch

WORKDIR /opt/rmf_demos_ws
RUN git clone https://github.com/open-rmf/rmf_demos.git src/rmf_demos \
    && git -C src/rmf_demos checkout "${RMF_DEMOS_COMMIT}" \
    && . /opt/ros/jazzy/setup.sh \
    && rosdep init 2>/dev/null || true \
    && colcon build --merge-install --packages-select rmf_demos_maps rmf_demos_assets \
         --parallel-workers 2 \
         --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && mkdir -p /opt/rmf_demos_ws/hotel-models \
    && cp -a build/rmf_demos_maps/maps/hotel/models/. /opt/rmf_demos_ws/hotel-models/ \
    && rm -rf build log src/rmf_demos/.git

COPY scripts/prepare_hotel_baseline.py /tmp/prepare_hotel_baseline.py
COPY scripts/patch_hotel_world_add_robot.py /tmp/patch_hotel_world_add_robot.py
COPY scripts/patch_hotel_robot_physics.py /tmp/patch_hotel_robot_physics.py
COPY scripts/patch_hotel_lift_wall_collisions.py /tmp/patch_hotel_lift_wall_collisions.py
COPY scripts/hotel-build/create_stubs.py /tmp/create_hotel_stubs.py
RUN mkdir -p /opt/ros2-demo/hotel-assets \
    && WORLD=$(find /opt/rmf_demos_ws -path '*/maps/hotel/hotel.world' -type f | head -1) \
    && BUILDING=$(find /opt/rmf_demos_ws -path '*/maps/hotel/hotel.building.yaml' -type f | head -1) \
    && GRAPH=$(find /opt/rmf_demos_ws -path '*/maps/hotel/nav_graphs/0.yaml' -type f | head -1) \
    && MAPS=$(dirname "${BUILDING}") \
      && python3 /tmp/prepare_hotel_baseline.py \
         --building "${BUILDING}" --world "${WORLD}" \
         --maps "${MAPS}" \
         --nav-graph "${GRAPH}" --output /opt/ros2-demo/hotel-assets \
         --commit "${RMF_DEMOS_COMMIT}" \
      && cp -a /opt/rmf_demos_ws/hotel-models /opt/ros2-demo/hotel-assets/models \
       && python3 /tmp/patch_hotel_robot_physics.py /opt/ros2-demo/hotel-assets/hotel.world \
      && python3 /tmp/patch_hotel_lift_wall_collisions.py /opt/ros2-demo/hotel-assets/hotel.world \
      && STUB_MODEL_BASE=/opt/ros2-demo/hotel-assets/models python3 /tmp/create_hotel_stubs.py \
     && python3 -m py_compile /tmp/prepare_hotel_baseline.py \
       && rm /tmp/prepare_hotel_baseline.py /tmp/patch_hotel_world_add_robot.py \
            /tmp/patch_hotel_robot_physics.py /tmp/patch_hotel_lift_wall_collisions.py \
            /tmp/create_hotel_stubs.py

COPY config/nav2 /opt/ros2-demo/config/nav2
COPY config/cyclonedds/hotel-nav2-rmf.xml /opt/ros2-demo/config/cyclonedds.xml
COPY config/rmf/fleet_config.hotel_nav2.yaml /opt/ros2-demo/rmf/fleet_config.yaml
COPY scripts/local_nav2_fleet_adapter.py /opt/ros2-demo/scripts/local_nav2_fleet_adapter.py
COPY scripts/odom_tf_authority.py /opt/ros2-demo/scripts/odom_tf_authority.py
COPY scripts/scan_frame_rewriter.py /opt/ros2-demo/scripts/scan_frame_rewriter.py
COPY scripts/lift_request_relay.py /opt/ros2-demo/scripts/lift_request_relay.py
COPY scripts/camera_follow_supervisor.py /opt/ros2-demo/scripts/camera_follow_supervisor.py
COPY scripts/validate_hotel_baseline.py /opt/ros2-demo/scripts/validate_hotel_baseline.py
COPY entrypoints/entrypoint-hotel-nav2-rmf.sh /entrypoint-hotel-nav2-rmf.sh
COPY scripts/turtlebot3_waffle.urdf /opt/ros2-demo/robot/turtlebot3_waffle.urdf
COPY config/hotel/xorg-dummy.conf /etc/X11/xorg-dummy.conf
COPY scripts/patch_nav2_disable_docking.py /tmp/patch_nav2_disable_docking.py
RUN mkdir -p /opt/ros2-demo/maps /opt/ros2-demo/rmf \
    && cp /opt/ros2-demo/hotel-assets/nav_graph.yaml /opt/ros2-demo/rmf/nav_graph.yaml \
    && cp /opt/ros2-demo/hotel-assets/maps/hotel_*.yaml /opt/ros2-demo/maps/ \
    && cp /opt/ros2-demo/hotel-assets/maps/hotel_*.pgm /opt/ros2-demo/maps/ \
     && python3 /opt/ros2-demo/scripts/validate_hotel_baseline.py /opt/ros2-demo/hotel-assets \
     && python3 /tmp/patch_nav2_disable_docking.py \
     && rm /tmp/patch_nav2_disable_docking.py \
     && chmod +x /entrypoint-hotel-nav2-rmf.sh /opt/ros2-demo/scripts/*.py

ENV GZ_SIM_RESOURCE_PATH=/opt/ros2-demo/hotel-assets/models:/opt/ros2-demo/hotel-assets:/opt/rmf_demos_ws/install/share/rmf_demos_assets/models \
    GZ_SIM_SYSTEM_PLUGIN_PATH=/opt/ros/jazzy/opt/gz_sim_vendor/lib/gz-sim-8/plugins \
    CYCLONEDDS_URI=file:///opt/ros2-demo/config/cyclonedds.xml
WORKDIR /opt/ros2-demo
CMD ["/entrypoint-hotel-nav2-rmf.sh"]
